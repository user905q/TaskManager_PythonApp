/* --- Основной фон --- */
QMainWindow, QDialog { background-color: #F8F9FA; }
QWidget { color: #212529; }

/* --- Вкладки --- */
QTabWidget::pane { border: 1px solid #DEE2E6; background: #FFFFFF; }
QTabBar::tab { background: #E9ECEF; color: #495057; padding: 8px 16px; border: 1px solid #DEE2E6; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; }
QTabBar::tab:selected { background: #FFFFFF; color: #000000; font-weight: bold; border-bottom: 2px solid #F97316; }

/* --- Тулбар и Меню --- */
QToolBar { background: #FFFFFF; border-bottom: 1px solid #DEE2E6; }
QToolBar QToolButton { color: #212529; padding: 4px; }
QToolBar QToolButton:hover { background: #E9ECEF; border-radius: 4px; }
QMenuBar { background: #FFFFFF; color: #212529; }
QMenuBar::item:selected { background: #E9ECEF; }

/* --- Контекстное меню (Светлая тема) --- */

QMenu { 
    background-color: #FFFFFF; 
    border: 1px solid #CED4DA; 
    border-radius: 4px; 
}
QMenu::item { 
    padding: 8px 24px; 
    color: #212529; /* Темный текст */
    background-color: #FFFFFF; 
}
QMenu::item:selected { 
    background-color: #F97316; 
    color: #FFFFFF; /* Белый текст при наведении */
}

/* --- Карточки --- */
TaskCard { background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 6px; }
TaskCard:hover { border: 1px solid #F97316; }

SectionCard { background-color: #FFFFFF; border-left: 1px solid #DEE2E6; border-right: 1px solid #DEE2E6; border-bottom: 1px solid #DEE2E6; border-radius: 6px; }

KanbanColumnWidget { background: #F1F3F5; border: 1px solid #DEE2E6; border-radius: 8px; }

/* --- Текст --- */
QLabel[class="task_subtext"] { color: #6C757D; font-size: 11px; border: none; }
QLabel[class="task_deadline"] { color: #DC3545; font-size: 11px; font-weight: bold; border: none; }
QLabel[class="section_progress"] { color: #F97316; font-weight: bold; border: none; }

/* --- Списки --- */
QListWidget { background: transparent; border: none; color: #212529; }
QListWidget::item { border-bottom: 1px solid #E9ECEF; padding: 5px; min-height: 25px; }
QListWidget::item:selected { background-color: #FFEDD5; color: #212529; border: none; outline: none; }
QListWidget#section_task_list { background: transparent; border: none; }

/* --- Кнопки --- */
QPushButton { background-color: #F97316; color: white; border-radius: 4px; padding: 6px 12px; border: none; font-weight: bold; }
QPushButton:hover { background-color: #EA580C; }
QPushButton:pressed { background-color: #C2410C; }

/* Кнопка "+ задача" */
QPushButton#btn_add { 
    background-color: #FFF7ED; 
    color: #EA580C; 
    border: 1px solid #F97316; 
    border-radius: 4px; 
    padding: 4px; 
    font-weight: bold;
}
QPushButton#btn_add:hover { 
    background-color: #F97316; 
    color: black; 
}
QPushButton#btn_add:hover { background-color: #F97316; color: black; }
QPushButton#btn_add:pressed { background-color: #C2410C; color: black; } /* Темно-оранжевый при нажатии */


/* --- Прогресс-бар --- */
QProgressBar { border: none; background: #E9ECEF; border-radius: 2px; }
QProgressBar::chunk { background: #F97316; border-radius: 2px; }

/* --- Поля ввода и выпадающие списки --- */
QComboBox, QLineEdit, QTextEdit, QDateTimeEdit { 
    background-color: #FFFFFF; color: #212529; border: 1px solid #CED4DA; border-radius: 4px; padding: 4px; 
}
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #212529; selection-background-color: #FFEDD5; }

/* --- Статистика (убираем белый фон) --- */
QFrame#chart_frame, QFrame#summary_frame {
    background-color: transparent;
}

/* --- Полосы прокрутки --- */
QScrollBar:vertical { background: #F8F9FA; width: 12px; }
QScrollBar::handle:vertical { background: #CED4DA; border-radius: 6px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: #F97316; }


QFrame#summary_frame { background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 6px; }
QLabel[class="summary_label"] { color: #212529; font-size: 14px; font-weight: bold; border: none; }
QTextEdit#compare_text { background: #FFFFFF; color: #212529; border: 1px solid #DEE2E6; }